@startuml
title Estágio FACSI — Diagrama de Classes — Domínio Final

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Pessoas" {
  abstract class Pessoa {
    - id : Long
    - nome : String
    - cpf : String
    - email : String
    - telefone : String
  }

  class Aluno {
    - matricula : String
    - curso : String
    - situacaoAcademica : String
  }

  class Professor {
    - siape : String
    - unidadeAcademica : String
  }

  class Profissional {
    - profissao : String
    - cargo : String
    - registroProfissional : String
  }

  Pessoa <|-- Aluno
  Pessoa <|-- Professor
  Pessoa <|-- Profissional
}

package "Institucional" {
  class Concedente {
    - id : Long
    - nome : String
    - tipo : String
    - documento : String
    - email : String
    - telefone : String
  }

  class Convenio {
    - id : Long
    - numeroReferencia : String
    - dataInicio : LocalDate
    - dataFim : LocalDate
    - status : String
    + estaVigenteEm(data : LocalDate) : boolean
  }

  Concedente "1" -- "0..*" Convenio
}

package "Oportunidade" {
  class Vaga {
    - id : Long
    - titulo : String
    - descricao : String
    - modalidade : ModalidadeEstagio
    - cargaHorariaDiaria : Integer
    - cargaHorariaSemanal : Integer
    - valorBolsaOfertado : BigDecimal
    - valorAuxilioTransporteOfertado : BigDecimal
    - duracaoPrevista : String
    - requisitos : String
    - status : String
  }

  class Candidatura {
    - id : Long
    - dataCandidatura : LocalDate
    - dataDecisao : LocalDate
    - status : String
    - observacao : String
  }

  Concedente "1" -- "0..*" Vaga
  Aluno "1" -- "0..*" Candidatura
  Vaga "1" -- "0..*" Candidatura
}

package "Vínculo de Estágio" {
  enum ModalidadeEstagio {
    OBRIGATORIO
    NAO_OBRIGATORIO
  }

  enum OrigemEstagio {
    VAGA_PUBLICADA
    CONTATO_DIRETO
    PROJETO_EXTENSAO
    PROJETO_PESQUISA
    EMPRESA_JUNIOR
    OUTRO
  }

  enum AmbitoEstagio {
    INTERNO
    EXTERNO
  }

  enum StatusEstagio {
    EM_FORMALIZACAO
    ATIVO
    ENCERRADO
    CANCELADO
  }

  class Estagio {
    {static} + LIMITE_HORAS_DIARIAS : int = 6
    {static} + LIMITE_HORAS_SEMANAIS : int = 30
    - id : Long
    - modalidade : ModalidadeEstagio
    - origem : OrigemEstagio
    - ambito : AmbitoEstagio
    - dataInicio : LocalDate
    - dataFimPrevista : LocalDate
    - dataFimReal : LocalDate
    - cargaHorariaDiaria : Integer
    - cargaHorariaSemanal : Integer
    - cargaHorariaTotalPrevista : Integer
    - status : StatusEstagio
    + iniciar() : boolean
    + encerrar(dataFimReal : LocalDate) : boolean
    + calcularHorasRealizadas() : int
    + calcularHorasNaData(data : LocalDate) : int
    + calcularHorasNaSemana(dataReferencia : LocalDate) : int
    + respeitaLimiteDiario() : boolean
    + respeitaLimiteSemanal() : boolean
    + estaVigenteEm(data : LocalDate) : boolean
    + possuiPeriodoSobreposto(outro : Estagio) : boolean
  }

  class TermoCompromisso {
    - id : Long
    - dataCriacao : LocalDate
    - remunerado : boolean
    - valorRemuneracao : BigDecimal
    - valorAuxilioTransporte : BigDecimal
    - status : String
  }

  class PlanoAtividades {
    - id : Long
    - areaAtuacao : String
    - justificativa : String
    - objetivoGeral : String
    - objetivosEspecificos : String
    - descricaoAtividades : String
    - adequacaoPedagogica : String
    - cronograma : String
    - status : String
  }

  class ApoliceSeguro {
    - id : Long
    - numero : String
    - seguradora : String
    - dataInicio : LocalDate
    - dataFim : LocalDate
    - documentoReferencia : String
    + estaVigenteEm(data : LocalDate) : boolean
  }

  class RegistroFrequencia {
    - id : Long
    - data : LocalDate
    - quantidadeHoras : Integer
    - descricaoAtividade : String
  }

  class RelatorioFinal {
    - id : Long
    - temaObjeto : String
    - justificativa : String
    - objetivos : String
    - metodologia : String
    - atividadesRealizadas : String
    - dificuldadesEncontradas : String
    - conclusao : String
    - dataEntrega : LocalDate
  }

  class AvaliacaoEstagio {
    - id : Long
    - dataAvaliacao : LocalDate
    - parecerSupervisor : String
    - parecerOrientador : String
    - resultado : String
    - observacao : String
  }

  Aluno "1" -- "0..*" Estagio
  Concedente "1" -- "0..*" Estagio
  Convenio "0..1" -- "0..*" Estagio : fundamenta

  Vaga "0..1" -- "0..1" Estagio : origem
  Candidatura "0..1" -- "0..1" Estagio : origina

  Estagio "0..*" --> "0..1" Pessoa : supervisor
  Estagio "0..*" --> "0..1" Professor : orientador

  Estagio "1" -- "0..1" TermoCompromisso
  Estagio "1" -- "0..*" PlanoAtividades : histórico
  Estagio "0..*" -- "0..*" ApoliceSeguro : cobertura
  Estagio "1" -- "0..*" RegistroFrequencia
  Estagio "1" -- "0..1" RelatorioFinal
  Estagio "1" -- "0..1" AvaliacaoEstagio
}

note right of Estagio
  Estado inicial: EM_FORMALIZACAO.
  iniciar() valida período, documentos,
  convênio quando externo e seguro vigente.
  encerrar() exige requisitos de conclusão
  e data final coerente com a frequência.
end note

note bottom of AvaliacaoEstagio
  resultado permanece String no código atual.
  Conceitos oficiais ainda dependem
  de validação acadêmica.
end note

@enduml
