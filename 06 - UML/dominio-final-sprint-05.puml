@startuml
title Estágio FACSI — Diagrama de Classes — Domínio Final

top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 28
skinparam packageStyle rectangle
hide empty members

package "Pessoas" {
  abstract class Pessoa {
    - id : Long
    - nome : String
    - cpf : String
    - email : String
  }

  class Aluno {
    - matricula : String
    - curso : String
  }

  class Professor {
    - siape : String
    - unidadeAcademica : String
  }

  class Profissional {
    - profissao : String
    - cargo : String
    - registroProfissional : String
  }

  Pessoa <|-- Aluno
  Pessoa <|-- Professor
  Pessoa <|-- Profissional
}

package "Institucional" {
  class Concedente {
    - id : Long
    - nome : String
    - tipo : String
    - documento : String
  }

  class Convenio {
    - id : Long
    - numeroReferencia : String
    - dataInicio : LocalDate
    - dataFim : LocalDate
    - status : String
    + estaVigenteEm(data : LocalDate) : boolean
  }

  Concedente "1" -- "0..*" Convenio
}

package "Oportunidade" {
  class Vaga {
    - id : Long
    - titulo : String
    - modalidade : ModalidadeEstagio
    - cargaHorariaSemanal : Integer
    - valorBolsaOfertado : BigDecimal
    - valorAuxilioTransporteOfertado : BigDecimal
    - status : String
  }

  class Candidatura {
    - id : Long
    - dataCandidatura : LocalDate
    - dataDecisao : LocalDate
    - status : String
  }

  Concedente "1" -- "0..*" Vaga
  Aluno "1" -- "0..*" Candidatura
  Vaga "1" -- "0..*" Candidatura
}

package "Vínculo de Estágio" {
  class Estagio {
    {static} + LIMITE_HORAS_DIARIAS : int = 6
    {static} + LIMITE_HORAS_SEMANAIS : int = 30
    - id : Long
    - modalidade : ModalidadeEstagio
    - origem : OrigemEstagio
    - ambito : AmbitoEstagio
    - dataInicio : LocalDate
    - dataFimPrevista : LocalDate
    - dataFimReal : LocalDate
    - cargaHorariaTotalPrevista : Integer
    - status : StatusEstagio
    + iniciar() : boolean
    + encerrar(dataFimReal : LocalDate) : boolean
    + calcularHorasRealizadas() : int
    + calcularHorasNaData(data : LocalDate) : int
    + calcularHorasNaSemana(data : LocalDate) : int
    + possuiPeriodoSobreposto(outro : Estagio) : boolean
  }
}

package "Documentos e acompanhamento" {
  class TermoCompromisso {
    - dataCriacao : LocalDate
    - remunerado : boolean
    - valorRemuneracao : BigDecimal
    - valorAuxilioTransporte : BigDecimal
    - status : String
  }

  class PlanoAtividades {
    - areaAtuacao : String
    - objetivoGeral : String
    - descricaoAtividades : String
    - cronograma : String
    - status : String
  }

  class ApoliceSeguro {
    - numero : String
    - seguradora : String
    - dataInicio : LocalDate
    - dataFim : LocalDate
    + estaVigenteEm(data : LocalDate) : boolean
  }

  class RegistroFrequencia {
    - data : LocalDate
    - quantidadeHoras : Integer
    - descricaoAtividade : String
  }

  class RelatorioFinal {
    - temaObjeto : String
    - atividadesRealizadas : String
    - conclusao : String
    - dataEntrega : LocalDate
  }

  class AvaliacaoEstagio {
    - dataAvaliacao : LocalDate
    - parecerSupervisor : String
    - parecerOrientador : String
    - resultado : String
  }

  TermoCompromisso -[hidden]right- PlanoAtividades
  PlanoAtividades -[hidden]right- ApoliceSeguro
  RegistroFrequencia -[hidden]right- RelatorioFinal
  RelatorioFinal -[hidden]right- AvaliacaoEstagio
}

package "Tipos do Estágio" {
  enum ModalidadeEstagio {
    OBRIGATORIO
    NAO_OBRIGATORIO
  }

  enum OrigemEstagio {
    VAGA_PUBLICADA
    CONTATO_DIRETO
    PROJETO_EXTENSAO
    PROJETO_PESQUISA
    EMPRESA_JUNIOR
    OUTRO
  }

  enum AmbitoEstagio {
    INTERNO
    EXTERNO
  }

  enum StatusEstagio {
    EM_FORMALIZACAO
    ATIVO
    ENCERRADO
    CANCELADO
  }

  ModalidadeEstagio -[hidden]right- OrigemEstagio
  AmbitoEstagio -[hidden]right- StatusEstagio
}

Aluno "1" -down- "0..*" Estagio
Concedente "1" -down- "0..*" Estagio
Convenio "0..1" -down- "0..*" Estagio : fundamenta
Vaga "0..1" -down- "0..1" Estagio : origem
Candidatura "0..1" -down- "0..1" Estagio : origina

Estagio "0..*" --> "0..1" Pessoa : supervisor
Estagio "0..*" --> "0..1" Professor : orientador

Estagio "1" -down- "0..1" TermoCompromisso
Estagio "1" -down- "0..*" PlanoAtividades : histórico
Estagio "0..*" -down- "0..*" ApoliceSeguro : cobertura
Estagio "1" -down- "0..*" RegistroFrequencia
Estagio "1" -down- "0..1" RelatorioFinal
Estagio "1" -down- "0..1" AvaliacaoEstagio

Estagio ..> ModalidadeEstagio
Estagio ..> OrigemEstagio
Estagio ..> AmbitoEstagio
Estagio ..> StatusEstagio

note right of Estagio
  Estado inicial: EM_FORMALIZACAO.
  iniciar() valida período, documentos,
  convênio externo e seguro vigente.
  encerrar() exige conclusão válida
  e data coerente com a frequência.
end note

note bottom of AvaliacaoEstagio
  resultado permanece String.
  Conceitos oficiais ainda dependem
  de validação acadêmica.
end note

@enduml
