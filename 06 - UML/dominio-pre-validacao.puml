@startuml
title Estágio FACSI — Modelo de Domínio (pré-validação documental)

skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Pessoas" {
  abstract class Pessoa {
    - id
    - nome
    - cpf
    - email
    - telefone
  }

  class Aluno {
    - matricula
    - curso
    - situacaoAcademica
  }

  class Professor {
    - siape
    - unidadeAcademica
  }

  Pessoa <|-- Aluno
  Pessoa <|-- Professor
}

package "Institucional" {
  class Concedente {
    - id
    - nome
    - tipo
    - documento
    - email
    - telefone
  }

  class Convenio {
    - id
    - numeroReferencia
    - dataInicio
    - dataFim
    - status
  }

  Concedente "1" -- "0..*" Convenio
}

package "Oportunidade" {
  class Vaga {
    - id
    - titulo
    - descricao
    - modalidade
    - cargaHorariaDiaria
    - cargaHorariaSemanal
    - valorBolsaOfertado
    - valorAuxilioTransporteOfertado
    - duracaoPrevista
    - requisitos
    - status
  }

  class Candidatura {
    - id
    - dataCandidatura
    - dataDecisao
    - status
    - observacao
  }

  Concedente "1" -- "0..*" Vaga
  Aluno "1" -- "0..*" Candidatura
  Vaga "1" -- "0..*" Candidatura
}

package "Vínculo de Estágio" {
  enum OrigemEstagio {
    VAGA_PUBLICADA
    CONTATO_DIRETO
    PROJETO_EXTENSAO
    PROJETO_PESQUISA
    EMPRESA_JUNIOR
    OUTRO
  }

  enum ModalidadeEstagio {
    OBRIGATORIO
    NAO_OBRIGATORIO
  }

  enum StatusEstagio {
    EM_FORMALIZACAO
    ATIVO
    ENCERRADO
    CANCELADO
  }

  class Estagio {
    - id
    - modalidade : ModalidadeEstagio
    - origem : OrigemEstagio
    - dataInicio
    - dataFimPrevista
    - dataFimReal
    - cargaHorariaDiaria
    - cargaHorariaSemanal
    - cargaHorariaTotalPrevista
    - status : StatusEstagio
  }

  class TermoCompromisso {
    - id
    - dataCriacao
    - remunerado
    - valorRemuneracao
    - valorAuxilioTransporte
    - horasSemanais
    - cargaHorariaTotalPrevista
    - dataInicio
    - dataFim
    - status
  }

  class PlanoAtividades {
    - id
    - areaAtuacao
    - justificativa
    - objetivoGeral
    - objetivosEspecificos
    - descricaoAtividades
    - adequacaoPedagogica
    - cronograma
    - status
  }

  class ApoliceSeguro {
    - id
    - numero
    - seguradora
    - dataInicio
    - dataFim
    - documentoReferencia
  }

  Aluno "1" -- "0..*" Estagio
  Concedente "1" -- "0..*" Estagio
  Convenio "0..1" -- "0..*" Estagio : fundamenta
  Vaga "0..1" -- "0..*" Estagio : origem opcional
  Candidatura "0..1" -- "0..1" Estagio : origem opcional

  Estagio "0..*" --> "1" Pessoa : supervisor
  Estagio "0..*" --> "1" Professor : orientador

  Estagio "1" -- "0..1" TermoCompromisso
  Estagio "1" -- "0..*" PlanoAtividades : histórico
  Estagio "0..*" -- "0..*" ApoliceSeguro : cobertura
}

note right of Estagio
  O limite geral considera o somatório
  de estágios simultâneos:
  6h/dia e 30h/semana.
end note

note right of TermoCompromisso
  Modalidade ≠ remuneração.
  Não obrigatório exige
  contrapartida financeira.
end note

note bottom of PlanoAtividades
  Prorrogação exige novo Plano
  anexado ao Termo Aditivo.
end note

note bottom of ApoliceSeguro
  Uma apólice institucional pode
  cobrir vários estagiários.
end note

@enduml
