@startuml
title Estágio FACSI — Modelo de Domínio (pré-validação)

skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Pessoas" {
  abstract class Pessoa {
    - id
    - nome
    - cpf
    - email
    - telefone
  }

  class Aluno {
    - matricula
    - curso
    - situacaoAcademica
  }

  class Professor {
    - siape
    - unidadeAcademica
  }

  Pessoa <|-- Aluno
  Pessoa <|-- Professor
}

package "Institucional" {
  class Concedente {
    - id
    - nome
    - tipo
    - documento
    - email
    - telefone
  }

  class Convenio {
    - id
    - numeroReferencia
    - dataInicio
    - dataFim
    - status
  }

  Concedente "1" -- "0..*" Convenio
}

package "Oportunidade" {
  class Vaga {
    - id
    - titulo
    - descricao
    - modalidade
    - cargaHorariaDiaria
    - cargaHorariaSemanal
    - valorBolsa
    - valorAuxilioTransporte
    - duracaoPrevista
    - requisitos
    - quantidadePosicoes
    - status
  }

  class Candidatura {
    - id
    - dataCandidatura
    - dataDecisao
    - status
    - observacao
  }

  Concedente "1" -- "0..*" Vaga
  Vaga "0..*" --> "0..1" Pessoa : supervisorPrevisto
  Aluno "1" -- "0..*" Candidatura
  Vaga "1" -- "0..*" Candidatura
}

package "Vínculo de Estágio" {
  enum OrigemEstagio {
    VAGA_PUBLICADA
    CONTATO_DIRETO
    PROJETO_EXTENSAO
    PROJETO_PESQUISA
    EMPRESA_JUNIOR
    OUTRO
  }

  enum ModalidadeEstagio {
    OBRIGATORIO
    NAO_OBRIGATORIO
  }

  enum StatusEstagio {
    EM_FORMALIZACAO
    ATIVO
    ENCERRADO
    CANCELADO
  }

  class Estagio {
    - id
    - modalidade : ModalidadeEstagio
    - origem : OrigemEstagio
    - dataInicio
    - dataFimPrevista
    - dataFimReal
    - cargaHorariaDiaria
    - cargaHorariaSemanal
    - status : StatusEstagio
  }

  class TermoCompromisso {
    - id
    - dataCriacao
    - dataAceiteAluno
    - dataAceiteConcedente
    - dataAceiteInstituicao
    - status
  }

  class PlanoAtividades {
    - id
    - objetivo
    - descricaoAtividades
    - justificativa
    - adequacaoPedagogica
    - status
  }

  class ApoliceSeguro {
    - id
    - numero
    - seguradora
    - dataInicio
    - dataFim
    - documentoReferencia
  }

  Aluno "1" -- "0..*" Estagio
  Concedente "1" -- "0..*" Estagio
  Convenio "0..1" -- "0..*" Estagio : fundamenta
  Vaga "0..1" -- "0..*" Estagio : origem opcional
  Candidatura "0..1" -- "0..1" Estagio : origem opcional

  Estagio "0..*" --> "1" Pessoa : supervisor
  Estagio "0..*" --> "1" Professor : orientador

  Estagio "1" -- "0..1" TermoCompromisso
  Estagio "1" -- "0..1" PlanoAtividades
  Estagio "0..*" -- "0..*" ApoliceSeguro : cobertura
}

note right of Estagio
  Vaga e Candidatura são opcionais.
  O Estágio pode nascer de contato direto,
  extensão, pesquisa ou Empresa Júnior.
end note

note bottom of Convenio
  Para concedente externa, o convênio
  deve estar válido quando aplicável.
end note

note bottom of PlanoAtividades
  Alterações do plano podem ser formalizadas
  por aditivos ao Termo de Compromisso.
end note

@enduml
